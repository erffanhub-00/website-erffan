---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [...new Set(allPosts.map((p) => p.data.category))].sort();
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags || []))].sort();

const dateLabel = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<BaseLayout title="Work" active="work">
  <section class="mb-10 pb-10 border-b" style="border-color: var(--line);">
    <h1 class="text-[30px] font-bold tracking-tight mb-3">Work</h1>
    <p class="text-[15px] m-0" style="color: var(--muted);">
      Notes, essays, and things I figure out along the way.
    </p>
  </section>

  <section class="mb-8">
    <label for="searchInput" class="sr-only">Search posts</label>
    <input
      id="searchInput"
      type="search"
      placeholder="Search posts..."
      class="w-full px-4 py-3 rounded-lg text-[14px] outline-none mb-4"
      style="background: var(--card); border: 1px solid var(--line); color: var(--fg);"
    />

    <div class="scroll-row mb-2" id="categoryFilter">
      <button
        data-category=""
        class="category-btn scroll-pill"
        aria-pressed="true"
        style="background: var(--fg); color: var(--bg); border-color: var(--fg);"
      >
        All
      </button>
      {categories.map((cat) => (
        <button
          data-category={cat}
          class="category-btn scroll-pill"
          aria-pressed="false"
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="scroll-row" id="tagFilter">
      <button
        data-tag=""
        class="tag-btn scroll-pill"
        aria-pressed="true"
        style="background: var(--fg); color: var(--bg); border-color: var(--fg);"
      >
        All tags
      </button>
      {allTags.map((tag) => (
        <button
          data-tag={tag}
          class="tag-btn scroll-pill"
          aria-pressed="false"
        >
          #{tag}
        </button>
      ))}
    </div>
  </section>

  <section>
    <div id="postsList" class="flex flex-col gap-3">
      {allPosts.map((post) => (
        <a
          href={`/posts/${post.id}`}
          class="post-card block relative rounded-lg p-5 pe-12 no-underline"
          style="background: var(--card); border: 1px solid var(--line); color: var(--fg);"
          data-category={post.data.category}
          data-tags={(post.data.tags || []).join(' ')}
          data-search={[post.data.title, post.data.description, post.data.category, ...(post.data.tags || [])].join(' ').toLowerCase()}
        >
          <div class="text-[12px] tracking-wide mb-1.5" style="color: var(--muted);">
            {dateLabel(post.data.date)} · {post.data.category}
            {post.data.readingTime ? ` · ${post.data.readingTime} min read` : ''}
          </div>
          <h3 class="text-base font-semibold mb-1.5">{post.data.title}</h3>
          <p class="text-sm leading-relaxed m-0" style="color: var(--muted);">
            {post.data.description}
          </p>
          {post.data.tags && post.data.tags.length ? (
            <div class="flex flex-wrap gap-1.5 mt-3">
              {post.data.tags.map((tag) => (
                <span
                  class="text-[10px] px-2 py-0.5 rounded-full"
                  style="background: var(--bg); border: 1px solid var(--line); color: var(--muted);"
                >#{tag}</span>
              ))}
            </div>
          ) : ''}
          <span class="post-arrow absolute end-5 top-1/2 -translate-y-1/2 text-lg" style="color: var(--muted);">→</span>
        </a>
      ))}
    </div>
    <p id="noResults" class="text-center py-8 text-[14px] hidden" style="color: var(--muted);">
      No posts found.
    </p>
  </section>

  <script is:inline>
    const searchInput = document.getElementById('searchInput');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const tagBtns = document.querySelectorAll('.tag-btn');
    const cards = document.querySelectorAll('#postsList .post-card');
    const noResults = document.getElementById('noResults');

    let activeCategory = '';
    let activeTag = '';
    let query = '';

    const urlParams = new URLSearchParams(window.location.search);
    const urlTag = urlParams.get('tag');
    if (urlTag) {
      activeTag = urlTag;
    }

    function applyActiveStyles(btns, activeValue, dataAttr) {
      btns.forEach((b) => {
        const isActive = b.dataset[dataAttr] === activeValue;
        b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        if (isActive) {
          b.style.background = 'var(--fg)';
          b.style.color = 'var(--bg)';
          b.style.borderColor = 'var(--fg)';
        } else {
          b.style.background = 'transparent';
          b.style.color = 'var(--muted)';
          b.style.borderColor = 'var(--line)';
        }
      });
    }

    function render() {
      const q = query.toLowerCase().trim();
      let visible = 0;

      cards.forEach((card) => {
        const matchesCategory = !activeCategory || card.dataset.category === activeCategory;
        const matchesTag = !activeTag || (card.dataset.tags || '').split(' ').includes(activeTag);
        const matchesQuery = !q || (card.dataset.search || '').includes(q);
        const show = matchesCategory && matchesTag && matchesQuery;
        card.hidden = !show;
        if (show) visible++;
      });

      noResults.classList.toggle('hidden', visible !== 0);
    }

    function syncTagInUrl() {
      const url = new URL(window.location.href);
      if (activeTag) {
        url.searchParams.set('tag', activeTag);
      } else {
        url.searchParams.delete('tag');
      }
      history.replaceState(null, '', url);
    }

    searchInput.addEventListener('input', (e) => { query = e.target.value; render(); });

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.category;
        applyActiveStyles(categoryBtns, activeCategory, 'category');
        render();
      });
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTag = btn.dataset.tag;
        applyActiveStyles(tagBtns, activeTag, 'tag');
        syncTagInUrl();
        render();
      });
    });

    applyActiveStyles(categoryBtns, activeCategory, 'category');
    applyActiveStyles(tagBtns, activeTag, 'tag');
    render();

    // Drag to scroll for .scroll-row
    document.querySelectorAll('.scroll-row').forEach((row) => {
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      row.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - row.offsetLeft;
        scrollLeft = row.scrollLeft;
      });

      row.addEventListener('mouseleave', () => { isDown = false; });
      row.addEventListener('mouseup', () => { isDown = false; });

      row.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - row.offsetLeft;
        const walk = (x - startX) * 1.5;
        row.scrollLeft = scrollLeft - walk;
      });
    });
  </script>
</BaseLayout>
