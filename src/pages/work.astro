---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const postsData = allPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  dateLabel: post.data.date.toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
  }),
  readingTime: post.data.readingTime,
}));

const categories = [...new Set(allPosts.map((p) => p.data.category))].sort();
---

<BaseLayout title="Work" active="work">
  <section class="mb-10 pb-10 border-b" style="border-color: var(--line);">
    <h1 class="text-[30px] font-bold tracking-tight mb-3">Work</h1>
    <p class="text-[15px] m-0" style="color: var(--muted);">
      Notes, essays, and things I figure out along the way.
    </p>
  </section>

  <section class="mb-10">
    <div class="flex flex-col gap-4">
      <input
        id="searchInput"
        type="search"
        placeholder="Search posts..."
        class="w-full px-4 py-3 rounded-lg text-[14px] outline-none"
        style="background: var(--card); border: 1px solid var(--line); color: var(--fg);"
      />

      <div class="flex flex-wrap gap-2" id="categoryFilter">
        <button
          data-category=""
          class="category-btn px-3 py-1.5 rounded-full text-[12px] cursor-pointer"
          style="background: var(--fg); color: var(--bg); border: 1px solid var(--fg);"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            data-category={cat}
            class="category-btn px-3 py-1.5 rounded-full text-[12px] cursor-pointer"
            style="background: transparent; color: var(--muted); border: 1px solid var(--line);"
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div id="postsList" class="flex flex-col gap-3"></div>
    <p id="noResults" class="text-center py-8 text-[14px] hidden" style="color: var(--muted);">
      No posts found.
    </p>
  </section>

  <script is:inline define:vars={{ postsData }}>
    const posts = postsData;
    const searchInput = document.getElementById('searchInput');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const postsList = document.getElementById('postsList');
    const noResults = document.getElementById('noResults');

    let activeCategory = '';
    let query = '';

    function render() {
      const filtered = posts.filter((p) => {
        const matchesCategory = !activeCategory || p.category === activeCategory;
        const q = query.toLowerCase().trim();
        const matchesQuery = !q ||
          p.title.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.category.toLowerCase().includes(q) ||
          (p.tags && p.tags.some((t) => t.toLowerCase().includes(q)));
        return matchesCategory && matchesQuery;
      });

      if (filtered.length === 0) {
        postsList.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }

      noResults.classList.add('hidden');
      postsList.innerHTML = filtered.map((p) => `
        <a href="/posts/${p.id}" class="post-card block relative rounded-lg p-5 pr-12 no-underline"
           style="background: var(--card); border: 1px solid var(--line); color: var(--fg);">
          <div class="text-[12px] tracking-wide mb-1.5" style="color: var(--muted);">
            ${p.dateLabel} · ${p.category}${p.readingTime ? ` · ${p.readingTime} min read` : ''}
          </div>
          <h3 class="text-base font-semibold mb-1.5">${p.title}</h3>
          <p class="text-sm leading-relaxed m-0" style="color: var(--muted);">
            ${p.description}
          </p>
          <span class="post-arrow absolute right-5 top-1/2 -translate-y-1/2 text-lg" style="color: var(--muted);">→</span>
        </a>
      `).join('');
    }

    searchInput.addEventListener('input', (e) => { query = e.target.value; render(); });

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.category;
        categoryBtns.forEach((b) => {
          if (b === btn) {
            b.style.background = 'var(--fg)';
            b.style.color = 'var(--bg)';
            b.style.borderColor = 'var(--fg)';
          } else {
            b.style.background = 'transparent';
            b.style.color = 'var(--muted)';
            b.style.borderColor = 'var(--line)';
          }
        });
        render();
      });
    });

    render();
  </script>
</BaseLayout>