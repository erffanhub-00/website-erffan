---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="erffanhub-00" active="about">
  <section class="mb-12 pb-12 border-b" style="border-color: var(--line);">
    <h1 class="text-[30px] font-bold tracking-tight mb-3">erffanhub-00</h1>
    <p class="text-[15px] m-0" style="color: var(--muted);">
      Learner, builder, and in love with breaking things to understand them.
    </p>
  </section>

  <section class="mb-12 pb-12 border-b" style="border-color: var(--line);">
    <h2 class="text-xs uppercase tracking-widest mb-5" style="color: var(--muted);">
      Who am I?
    </h2>
    <p class="mb-4">
      Computers make me crazy. And I love every second of it. I don't just use
      technology — I chase it. I tear it apart, figure out why it works, and put
      it back together better.
    </p>
    <p>
      Above all, I'm a learner — and I'm not afraid to start from zero, because
      that's where real growth begins.
    </p>
  </section>

  <section>
    <h2 class="text-xs uppercase tracking-widest mb-5" style="color: var(--muted);">
      Fun fact
    </h2>
    <p class="italic border-l-2 pl-5 m-0" style="border-color: var(--fg);">
      My best ideas come at 2 AM, when everyone else is asleep and the only sound
      is my keyboard.
    </p>
  </section>
</BaseLayout>