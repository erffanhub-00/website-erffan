---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="erffanhub-00" active="about">
  <section class="mb-12 pb-12 border-b" style="border-color: var(--line);">
    <h1 class="text-[30px] font-bold tracking-tight mb-3">
      <span class="type-target">erffanhub<span class="dim">-00</span></span><span class="type-cursor">▌</span>
    </h1>
    <p class="text-[15px] m-0" style="color: var(--muted);">
      Learner, builder, and in love with breaking things to understand them.
    </p>
  </section>

  <section class="mb-12 pb-12 border-b" style="border-color: var(--line);">
    <h2 class="text-xs uppercase tracking-widest mb-5" style="color: var(--muted);">
      Who am I?
    </h2>
    <p class="mb-4">
      Computers make me crazy. And I love every second of it. I don't just use
      technology — I chase it. I tear it apart, figure out why it works, and put
      it back together better.
    </p>
    <p>
      Above all, I'm a learner — and I'm not afraid to start from zero, because
      that's where real growth begins.
    </p>
  </section>

  <section class="mb-12 pb-12 border-b" style="border-color: var(--line);">
    <h2 class="text-xs uppercase tracking-widest mb-5" style="color: var(--muted);">
      Latest posts
    </h2>
    <div class="flex flex-col gap-3 mb-5">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
    <a href="/work" class="text-sm no-underline" style="color: var(--muted);">
      All posts →
    </a>
  </section>

  <section>
    <h2 class="text-xs uppercase tracking-widest mb-5" style="color: var(--muted);">
      Fun fact
    </h2>
    <p class="italic border-l-2 pl-5 m-0" style="border-color: var(--fg);">
      My best ideas come at 2 AM, when everyone else is asleep and the only sound
      is my keyboard.
    </p>
  </section>

  <script>
    (function () {
      const el = document.querySelector('.type-target');
      if (!el) return;
      // Copy to a non-null local: TS drops the narrowing inside closures.
      const target = el;

      // Reduced motion: keep the static heading as-is, no typing.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const base = 'erffanhub';
      const suffix = '-00';
      let i = 0;

      function typeChar() {
        if (i < base.length) {
          target.textContent = base.slice(0, i + 1);
          i++;
          setTimeout(typeChar, 110);
        } else {
          setTimeout(() => {
            target.innerHTML = base + '<span class="dim">' + suffix + '</span>';
          }, 200);
        }
      }

      target.textContent = '';
      setTimeout(typeChar, 300);
    })();
  </script>
</BaseLayout>
