---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatLongDate } from '../../utils/format';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Previous / next post in date order (newest first).
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const olderPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// Arrows point the reading direction: mirrored on Persian pages.
const backArrow = post.data.lang === 'fa' ? '→' : '←';
const prevArrow = post.data.lang === 'fa' ? '→' : '←';
const nextArrow = post.data.lang === 'fa' ? '←' : '→';
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  active="work"
  lang={post.data.lang}
  article={{ published: post.data.date, tags: post.data.tags }}
>
  <a
    href="/work"
    class="inline-flex items-center gap-1.5 text-[13px] no-underline mb-8"
    style="color: var(--muted);"
  >
    {backArrow} Back to Work
  </a>

  <article dir="auto">
    <header class="mb-10 pb-8 border-b" style="border-color: var(--line);">
      <div class="text-[13px] mb-4" style="color: var(--muted);">
        {formatLongDate(post.data.date, post.data.lang)} · {post.data.category}
        {post.data.readingTime && ` · ${post.data.readingTime} min read`}
      </div>
      <h1 class="text-[30px] font-bold tracking-tight m-0 mb-4">
        {post.data.title}
      </h1>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a
              href={`/work?tag=${encodeURIComponent(tag)}`}
              class="text-[11px] px-2 py-1 rounded-full no-underline transition-colors"
              style="background: var(--card); border: 1px solid var(--line); color: var(--muted);"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    {post.data.image && (
      <img src={post.data.image} alt={post.data.title}
           class="w-full rounded-lg mb-10" style="border: 1px solid var(--line);" />
    )}

    <div class="post-body">
      <Content />
    </div>

    <nav class="flex justify-between gap-4 mt-14 pt-8 border-t text-sm" style="border-color: var(--line);" aria-label="More posts">
      {olderPost ? (
        <a href={`/posts/${olderPost.id}`} class="no-underline" style="color: var(--muted);">
          {prevArrow} {olderPost.data.title}
        </a>
      ) : <span />}
      {newerPost ? (
        <a href={`/posts/${newerPost.id}`} class="no-underline text-end" style="color: var(--muted);">
          {newerPost.data.title} {nextArrow}
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>
