---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found">
  <div class="text-center py-20">
    <h1 class="text-[80px] font-bold tracking-tight m-0 mb-4" style="color: var(--muted);">
      404
    </h1>
    <p class="text-[16px] mb-8" style="color: var(--muted);">
      This page doesn't exist. Or maybe it never did.
    </p>
    <a
      href="/"
      class="inline-block px-6 py-3 rounded-lg no-underline text-[14px]"
      style="background: var(--fg); color: var(--bg);"
    >
      ← Go home
    </a>
  </div>
</BaseLayout>