---
import BaseLayout from '../layouts/BaseLayout.astro';
import { socialLinks } from '../data/site';
---

<BaseLayout title="Contact" active="contact">
  <section class="mb-12 pb-12 border-b" style="border-color: var(--line);">
    <h1 class="text-[30px] font-bold tracking-tight mb-3">Contact</h1>
    <p class="text-[15px] m-0" style="color: var(--muted);">
      Say hi. Ask questions. Challenge me.
    </p>
  </section>

  <section>
    <h2 class="text-xs uppercase tracking-widest mb-5" style="color: var(--muted);">
      Reach me
    </h2>
    <ul class="flex flex-wrap gap-x-5 gap-y-3 text-sm list-none p-0 m-0">
      {socialLinks.map((link) => (
        <li>
          <a
            href={link.url}
            {...(link.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
            class="no-underline"
            style="color: var(--muted);"
          >{link.label}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
